# Wordtime CMS — Apache (mod_rewrite)
# Установщик защищён сам: после установки install.php блокируется внутри PHP.
# Дополнительная блокировка на уровне Apache (раскомментируйте ПОСЛЕ установки):
# <Files "install.php">
#     Require all denied
# </Files>

# Служебные каталоги закрыты от прямого доступа
RedirectMatch 404 ^/wt-data/
<Files "wt-config.php">
    Require all denied
</Files>
<FilesMatch "\.(log|sql|cache|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Кеш статики
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Заголовки безопасности
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
